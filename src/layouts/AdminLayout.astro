---
import '../styles/tokens.css';
import '../styles/admin.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;

const NAV = [
  { href: '/', label: 'סקירה' },
  { href: '/leads/', label: 'לידים' },
  { href: '/traffic/', label: 'תנועה' },
  { href: '/search/', label: 'חיפוש' },
  { href: '/behavior/', label: 'התנהגות' },
  { href: '/journeys/', label: 'מסעות' },
  { href: '/sources/', label: 'מקורות נתונים' },
  { href: '/agent/', label: 'סוכן AI' },
] as const;

const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const email = Astro.locals.access?.email ?? '';
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ניהול תכל'ס משכנתא</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" href="/fonts/heebo-hebrew.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/heebo-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">דלג לתוכן</a>
    <div class="shell">
      <aside class="sidebar">
        <a class="sidebar__brand" href="/">
          תכל'ס · ניהול
          <small>admin.tachles-mashkanta.co.il</small>
        </a>
        <nav class="sidebar__nav" aria-label="ניווט">
          {NAV.map((item) => (
            <a class="navlink" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        {email && <p class="sidebar__signed-in">מחובר/ת: {email}</p>}
      </aside>
      <main id="main" class="content">
        <slot />
      </main>
    </div>
    <script>
      // On mobile the nav is a horizontally scrolling strip; without this the current
      // page's link can land off-screen with nothing visibly highlighted (looks broken).
      document.querySelector('.navlink[aria-current="page"]')?.scrollIntoView({ inline: 'center', block: 'nearest' });
    </script>
  </body>
</html>
