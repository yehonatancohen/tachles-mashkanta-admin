---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import PeriodPicker from '../../components/PeriodPicker.astro';
import ActivityTable from '../../components/ActivityTable.astro';
import { getEnv } from '../../server/env';
import { resolvePeriod } from '../../server/period';
import { listJourneys } from '../../server/queries/journeys';

const env = getEnv();
const period = resolvePeriod(Astro.url);
const converted = Astro.url.searchParams.get('converted') === '1';
const journeys = await listJourneys(env, period, { converted }, 200);

const qs = (overrides: Record<string, string | undefined>) => {
  const p = new URLSearchParams(Astro.url.searchParams);
  for (const [k, v] of Object.entries(overrides)) (v ? p.set(k, v) : p.delete(k));
  return `?${p.toString()}`;
};
---

<AdminLayout title="מסעות">
  <div class="page-head">
    <h1>מסעות מבקרים</h1>
    <PeriodPicker period={period} />
  </div>

  <div class="filters">
    <a class="chip" href={qs({ converted: undefined })} aria-pressed={!converted ? 'true' : 'false'}>הכול</a>
    <a class="chip" href={qs({ converted: '1' })} aria-pressed={converted ? 'true' : 'false'}>הומרו לליד בלבד</a>
  </div>

  <ActivityTable rows={journeys} />
</AdminLayout>
