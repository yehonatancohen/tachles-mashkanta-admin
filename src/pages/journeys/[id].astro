---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getEnv } from '../../server/env';
import { sessionById, sessionTimeline } from '../../server/queries/journeys';

const env = getEnv();
const { id } = Astro.params;
const session = id ? await sessionById(env, id) : null;
const timeline = id ? await sessionTimeline(env, id) : [];

if (!session) {
  Astro.response.status = 404;
}
---

<AdminLayout title="מסע מבקר">
  <div class="page-head">
    <h1>מסע מבקר</h1>
    <a class="btn btn--quiet" href="/journeys/">חזרה לרשימה ⟵</a>
  </div>

  {!session ? (
    <p class="empty">המסע לא נמצא.</p>
  ) : (
    <>
      <section class="section card" style="display:grid; gap: var(--space-2); grid-template-columns: repeat(auto-fit, minmax(10rem,1fr));">
        <div><strong>נתיב:</strong> <bdi>{id}</bdi></div>
        <div><strong>דף כניסה:</strong> {session.entry_page}</div>
        <div><strong>מקור:</strong> {session.utm_source || '(direct)'}</div>
        <div><strong>מכשיר:</strong> {session.device}</div>
        <div><strong>מדינה:</strong> {session.country}</div>
        <div><strong>ליד:</strong> {session.lead_id ? <a href="/leads/">כן ⟵</a> : 'לא'}</div>
      </section>

      <section class="section">
        <h2>ציר זמן</h2>
        {timeline.length === 0 ? (
          <p class="empty">אין אירועים רשומים למסע הזה.</p>
        ) : (
          <ol style="display:grid; gap: var(--space-2); list-style:none; padding:0; margin:0;">
            {timeline.map((t) => (
              <li class="card" style="display:flex; gap: var(--space-4); align-items:baseline;">
                <span style="color: var(--c-text-3); font-size: var(--text-xs); white-space:nowrap;">{t.at.slice(11, 19)}</span>
                <span class="badge" style={t.kind === 'pageview' ? 'background:var(--c-accent-soft); color:var(--c-accent-ink);' : 'background:var(--c-surface-2); color:var(--c-text-2);'}>{t.kind === 'pageview' ? 'צפייה' : 'אירוע'}</span>
                <span><strong>{t.label}</strong>{t.detail ? ` · ${t.detail}` : ''}</span>
              </li>
            ))}
          </ol>
        )}
      </section>
    </>
  )}
</AdminLayout>
