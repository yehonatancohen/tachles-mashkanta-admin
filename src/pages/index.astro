---
export const prerender = false;
import AdminLayout from '../layouts/AdminLayout.astro';
import PeriodPicker from '../components/PeriodPicker.astro';
import KpiTile from '../components/KpiTile.astro';
import ActivityChart from '../components/ActivityChart.astro';
import ActivityTable from '../components/ActivityTable.astro';
import BarList from '../components/BarList.astro';
import Freshness from '../components/Freshness.astro';
import { getEnv } from '../server/env';
import { resolvePeriod } from '../server/period';
import { overviewKpis, funnel, topSources, topLandingPages } from '../server/queries/overview';
import { sourceStatuses } from '../server/queries/sources';
import { activitySeries } from '../server/queries/activity';
import { listJourneys } from '../server/queries/journeys';
import { listReports, listChanges } from '../server/queries/agent';
import { latestBrief, SEEN_COOKIE } from '../server/agent-brief';
import { fmtDateTime } from '../server/time';

const env = getEnv();
const period = resolvePeriod(Astro.url);

const [{ current, previous }, activity, recent, steps, sources, landing, reports, changes, syncStatus] = await Promise.all([
  overviewKpis(env, period),
  activitySeries(env),
  listJourneys(env, period, {}, 20),
  funnel(env, period),
  topSources(env, period),
  topLandingPages(env, period),
  listReports(env, 1),
  listChanges(env),
  sourceStatuses(env),
]);

const maxFunnel = Math.max(1, ...steps.map((s) => s.sessions));

const report = reports[0] ?? null;
const brief = report ? latestBrief(report, changes) : null;
// /agent/ stores the id of the newest report it showed; anything else here is unread.
const isNewReport = !!report && Astro.cookies.get(SEEN_COOKIE)?.value !== report.id;
---

<AdminLayout title="סקירה">
  <div class="page-head">
    <h1>סקירה</h1>
    <PeriodPicker period={period} />
  </div>
  <Freshness sources={syncStatus} />

  {isNewReport && brief && (
    <a class="notice" href="/agent/">
      <span class="notice__label">יש סיכום AI חדש</span>
      <span class="notice__text">{brief.headline}</span>
      <span class="notice__cta">לקריאה ⟵</span>
    </a>
  )}

  <section class="section">
    <div class="section__grid">
      <KpiTile label="מבקרים (סשנים)" value={String(current.sessions)} current={current.sessions} previous={previous.sessions} />
      <KpiTile label="לידים" value={String(current.leads)} current={current.leads} previous={previous.leads} />
      <KpiTile label="המרה לליד" value={`${current.cvPct}%`} current={current.cvPct} previous={previous.cvPct} />
      <KpiTile label="נתח דרגה A" value={`${current.tierAPct}%`} current={current.tierAPct} previous={previous.tierAPct} />
      <KpiTile label="זמן מעורבות ממוצע" value={`${current.avgEngagedS}s`} current={current.avgEngagedS} previous={previous.avgEngagedS} />
    </div>
  </section>

  <section class="section">
    <h2>פעולות באתר לאורך זמן</h2>
    <div class="card">
      <ActivityChart data={activity} />
    </div>
  </section>

  <section class="section">
    <div class="section__head">
      <h2>ביקורים אחרונים</h2>
      <a class="btn btn--quiet" href={`/journeys/${Astro.url.search}`}>כל הביקורים ⟵</a>
    </div>
    <ActivityTable rows={recent} />
  </section>

  <section class="section">
    <h2>משפך</h2>
    <div class="card barlist">
      {steps.map((s) => (
        <div class="barlist__row">
          <div class="barlist__label">
            <span class="barlist__name">{s.label}</span>
            <span class="barlist__track"><span class="barlist__fill" style={`inline-size: ${Math.round((s.sessions / maxFunnel) * 100)}%`}></span></span>
          </div>
          <span class="barlist__value">{s.sessions}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="section__grid">
    <section class="section">
      <h2>מקורות מובילים</h2>
      <div class="card">
        <BarList rows={sources.map((s) => ({ label: `${s.source} / ${s.medium}`, value: s.sessions, displayValue: `${s.sessions} · ${s.cvPct}%` }))} />
      </div>
    </section>
    <section class="section">
      <h2>דפי כניסה מובילים</h2>
      <div class="card">
        <BarList rows={landing.map((l) => ({ label: l.page, value: l.sessions, displayValue: `${l.sessions} · ${l.cvPct}%` }))} />
      </div>
    </section>
  </div>

  {report && brief && !isNewReport && (
    <section class="section">
      <h2>סוכן AI</h2>
      <a class="agent-line" href="/agent/">
        <span class="agent-line__text">{brief.headline}</span>
        <span class="agent-line__meta">סריקה אחרונה {fmtDateTime(report.createdAt)} · לסיכום ⟵</span>
      </a>
    </section>
  )}
</AdminLayout>
