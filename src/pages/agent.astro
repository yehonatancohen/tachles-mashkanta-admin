---
export const prerender = false;
import AdminLayout from '../layouts/AdminLayout.astro';
import { getEnv } from '../server/env';
import { listReports, listChanges, type AiChange } from '../server/queries/agent';
import { renderMarkdown } from '../server/markdown';
import { fmtDate, fmtDateTime } from '../server/time';

const env = getEnv();
const [reports, changes] = await Promise.all([listReports(env), listChanges(env)]);

function status(c: AiChange): { label: string; tone: 'a' | 'b' | 'c' } {
  if (c.result) return { label: 'נמדד', tone: 'a' };
  if (c.shippedAt) return { label: c.evaluatedAt ? 'בבדיקה' : 'עלה · ממתין לנתונים', tone: 'b' };
  if (c.prUrl) return { label: 'PR ממתין לאישור', tone: 'b' };
  return { label: 'הוצע', tone: 'c' };
}
---

<AdminLayout title="סוכן AI">
  <div class="page-head">
    <h1>סוכן AI</h1>
  </div>
  <p class="page-intro">
    הסוכן קורא את הנתונים כפעמיים בשבוע דרך <code>/api/export</code> וכותב לכאן דוחות והצעות שינוי,
    יחד עם ההשערה, המדד שאמור להשתנות והתוצאה בפועל בריצה הבאה.
  </p>

  <section class="section">
    <h2>דוחות</h2>
    {reports.length === 0 ? (
      <p class="empty">אין דוחות עדיין.</p>
    ) : (
      <div class="disclosure-list">
        {reports.map((r) => (
          <details class="disclosure">
            <summary class="disclosure__summary">
              <span class="disclosure__title">דוח {fmtDate(r.periodFrom)} – {fmtDate(r.periodTo)}</span>
              <span class="disclosure__meta">נכתב {fmtDateTime(r.createdAt)}</span>
            </summary>
            <div class="disclosure__body report-body" set:html={renderMarkdown(r.summaryMd)} />
          </details>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <h2>יומן שינויים</h2>
    {changes.length === 0 ? (
      <p class="empty">אין שינויים רשומים עדיין.</p>
    ) : (
      <div class="disclosure-list">
        {changes.map((c) => {
          const s = status(c);
          return (
            <details class="disclosure">
              <summary class="disclosure__summary">
                <span class="disclosure__date">{fmtDate(c.createdAt)}</span>
                <span class="disclosure__title disclosure__title--clamp">{c.description}</span>
                <span class={`badge badge--tier-${s.tone}`}>{s.label}</span>
              </summary>
              <dl class="disclosure__body kv">
                <dt>תיאור</dt><dd>{c.description}</dd>
                <dt>השערה</dt><dd>{c.hypothesis}</dd>
                <dt>מדד</dt><dd><code>{c.metric}</code>{c.baseline != null && <> · בסיס <bdi>{c.baseline}</bdi></>}</dd>
                <dt>תוצאה</dt><dd>{c.result ?? '—'}{c.evaluatedAt && ` (נבדק ${fmtDate(c.evaluatedAt)})`}</dd>
                <dt>PR</dt>
                <dd>
                  {c.prUrl ? <a href={c.prUrl} target="_blank" rel="noopener noreferrer"><bdi>{c.prUrl.replace(/^https:\/\/github\.com\//, '')}</bdi></a> : '—'}
                  {c.shippedAt && ` · עלה לאוויר ${fmtDate(c.shippedAt)}`}
                </dd>
                {c.files.length > 0 && (
                  <>
                    <dt>קבצים</dt>
                    <dd><ul class="kv__files">{c.files.map((f) => <li><bdi><code>{f}</code></bdi></li>)}</ul></dd>
                  </>
                )}
              </dl>
            </details>
          );
        })}
      </div>
    )}
  </section>
</AdminLayout>
